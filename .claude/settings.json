{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(uvicorn:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*secret*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File automation/hooks/block-dangerous.ps1"
          }
        ]
      }
    ]
  }
}
