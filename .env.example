ANTHROPIC_API_KEY=
APP_ENV=dev
APP_NAME=between-memories-service
API_PORT=8000

# Model routing defaults
MODEL_QUICK=claude-3-5-haiku-latest
MODEL_BUILD=claude-sonnet-4-5
